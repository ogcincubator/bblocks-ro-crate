    {
      "itemIdentifier": "ogc.researchobject.ro-crate.context",
      "name": "RO-Crate JSON-LD Context",
      "abstract": "Assembles the RO-Crate 1.3 JSON-LD context from its constituent vocabulary building blocks, and adds the RO-Crate-specific term overrides (`File`, `Journal`, `HTML`) and namespace prefix declarations. The context produced by this block is equivalent, term for term, to <https://w3id.org/ro/crate/1.3/context>.",
      "status": "under-development",
      "dateTimeAddition": "2026-08-12T00:00:00Z",
      "itemClass": "model",
