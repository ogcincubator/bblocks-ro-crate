        "ro-crate",
        "jsonld",
        "context"
      ],
      "highlighted": true,
      "sources": [
        {
          "title": "RO-Crate 1.3 Specification",
          "link": "https://www.researchobject.org/ro-crate/specification/1.3/"
        },
        {
          "title": "RO-Crate 1.3 JSON-LD Context",
          "link": "https://w3id.org/ro/crate/1.3/context"
        },
        {
          "title": "RO-Crate 1.3 Metadata section (vocabulary provenance)",
          "link": "https://www.researchobject.org/ro-crate/specification/1.3/metadata.html"
        }
      ],
