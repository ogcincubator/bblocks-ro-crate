{"defs":{},"properties":[{"path":["input"],"id":"https://bioschemas.org/terms/input","description":"An input required to use the computational workflow (e.g. an Excel spreadsheet, a BAM file).","required":true,"sources":["bblocks://ogc.researchobject.ro-crate.bioschemas.computational-workflow"],"effectiveId":"https://bioschemas.org/terms/input"},{"path":["output"],"id":"https://bioschemas.org/terms/output","description":"An output produced by the workflow.","required":true,"sources":["bblocks://ogc.researchobject.ro-crate.bioschemas.computational-workflow"],"effectiveId":"https://bioschemas.org/terms/output"},{"path":["creativeWorkStatus"],"id":"http://schema.org/creativeWorkStatus","description":"The status of the workflow in terms of its stage in a lifecycle, e.g. Incomplete, Draft, Published, Obsolete.","sources":["bblocks://ogc.researchobject.ro-crate.bioschemas.computational-workflow"],"effectiveId":"http://schema.org/creativeWorkStatus"},{"path":["documentation"],"id":"http://schema.org/documentation","description":"Documentation describing the ComputationalWorkflow and its use.","sources":["bblocks://ogc.researchobject.ro-crate.bioschemas.computational-workflow"],"effectiveId":"http://schema.org/documentation"},{"path":["funding"],"id":"http://schema.org/funding","description":"The funding for the workflow.","sources":["bblocks://ogc.researchobject.ro-crate.bioschemas.computational-workflow"],"effectiveId":"http://schema.org/funding"},{"path":["maintainer"],"id":"http://schema.org/maintainer","description":"The Person or Organization that manages contributions to, and/or publication of, the workflow.","sources":["bblocks://ogc.researchobject.ro-crate.bioschemas.computational-workflow"],"effectiveId":"http://schema.org/maintainer"},{"path":["softwareRequirements"],"id":"http://schema.org/softwareRequirements","description":"Component dependency requirements for the workflow (runtime environments, shared libraries not bundled with it).","sources":["bblocks://ogc.researchobject.ro-crate.bioschemas.computational-workflow"],"effectiveId":"http://schema.org/softwareRequirements"},{"path":["conditionsOfAccess"],"id":"http://schema.org/conditionsOfAccess","description":"Conditions that affect the availability of, or method(s) of access to, the workflow.","schema_type":"string","sources":["bblocks://ogc.researchobject.ro-crate.bioschemas.computational-workflow"],"effectiveId":"http://schema.org/conditionsOfAccess"},{"path":["targetProduct"],"id":"http://schema.org/targetProduct","description":"Target operating system(s) / product(s) to which the workflow applies.","sources":["bblocks://ogc.researchobject.ro-crate.bioschemas.computational-workflow"],"effectiveId":"http://schema.org/targetProduct"},{"path":["programmingLanguage"],"id":"http://schema.org/programmingLanguage","description":"The computer programming (or workflow) language.","required":true,"sources":["bblocks://ogc.researchobject.ro-crate.bioschemas.computational-workflow"],"effectiveId":"http://schema.org/programmingLanguage"},{"path":["runtimePlatform"],"id":"http://schema.org/runtimePlatform","description":"Runtime platform or script interpreter dependencies (e.g. Java 1, Python 2.3).","sources":["bblocks://ogc.researchobject.ro-crate.bioschemas.computational-workflow"],"effectiveId":"http://schema.org/runtimePlatform"},{"path":["alternateName"],"id":"http://schema.org/alternateName","description":"An alias for the workflow.","sources":["bblocks://ogc.researchobject.ro-crate.bioschemas.computational-workflow"],"effectiveId":"http://schema.org/alternateName"},{"path":["description"],"id":"http://schema.org/description","description":"A description of the workflow.","schema_type":"string","sources":["bblocks://ogc.researchobject.ro-crate.bioschemas.computational-workflow"],"effectiveId":"http://schema.org/description"},{"path":["identifier"],"id":"http://schema.org/identifier","description":"Any kind of identifier for the workflow (e.g. an ISBN, GTIN, or UUID).","sources":["bblocks://ogc.researchobject.ro-crate.bioschemas.computational-workflow"],"effectiveId":"http://schema.org/identifier"},{"path":["image"],"id":"http://schema.org/image","description":"An image of the workflow.","sources":["bblocks://ogc.researchobject.ro-crate.bioschemas.computational-workflow"],"effectiveId":"http://schema.org/image"},{"path":["name"],"id":"http://schema.org/name","description":"The name of the workflow.","required":true,"schema_type":"string","sources":["bblocks://ogc.researchobject.ro-crate.bioschemas.computational-workflow"],"effectiveId":"http://schema.org/name"},{"path":["url"],"id":"http://schema.org/url","description":"URL of the workflow.","required":true,"schema_type":"string","format":"uri","sources":["bblocks://ogc.researchobject.ro-crate.bioschemas.computational-workflow"],"effectiveId":"http://schema.org/url"},{"path":["citation"],"id":"http://schema.org/citation","description":"A citation or reference to another creative work related to the workflow.","sources":["bblocks://ogc.researchobject.ro-crate.bioschemas.computational-workflow"],"effectiveId":"http://schema.org/citation"},{"path":["contributor"],"id":"http://schema.org/contributor","description":"A secondary contributor to the workflow.","sources":["bblocks://ogc.researchobject.ro-crate.bioschemas.computational-workflow"],"effectiveId":"http://schema.org/contributor"},{"path":["creator"],"id":"http://schema.org/creator","description":"The creator/author of the workflow.","required":true,"sources":["bblocks://ogc.researchobject.ro-crate.bioschemas.computational-workflow"],"effectiveId":"http://schema.org/creator"},{"path":["dateCreated"],"id":"http://schema.org/dateCreated","description":"The date on which the workflow was created.","required":true,"schema_type":"string","format":"date","sources":["bblocks://ogc.researchobject.ro-crate.bioschemas.computational-workflow"],"effectiveId":"http://schema.org/dateCreated"},{"path":["dateModified"],"id":"http://schema.org/dateModified","description":"The date on which the workflow was most recently modified.","schema_type":"string","format":"date","sources":["bblocks://ogc.researchobject.ro-crate.bioschemas.computational-workflow"],"effectiveId":"http://schema.org/dateModified"},{"path":["datePublished"],"id":"http://schema.org/datePublished","description":"Date of first publication of the workflow.","schema_type":"string","format":"date","sources":["bblocks://ogc.researchobject.ro-crate.bioschemas.computational-workflow"],"effectiveId":"http://schema.org/datePublished"},{"path":["encodingFormat"],"id":"http://schema.org/encodingFormat","description":"Media type of the workflow, typically expressed as a MIME type (e.g. `application/zip`).","sources":["bblocks://ogc.researchobject.ro-crate.bioschemas.computational-workflow"],"effectiveId":"http://schema.org/encodingFormat"},{"path":["hasPart"],"id":"http://schema.org/hasPart","description":"A resource that is part of the workflow.","sources":["bblocks://ogc.researchobject.ro-crate.bioschemas.computational-workflow"],"effectiveId":"http://schema.org/hasPart"},{"path":["isBasedOn"],"id":"http://schema.org/isBasedOn","description":"A resource from which the workflow is derived, or of which it is a modification.","sources":["bblocks://ogc.researchobject.ro-crate.bioschemas.computational-workflow"],"effectiveId":"http://schema.org/isBasedOn"},{"path":["keywords"],"id":"http://schema.org/keywords","description":"Keywords or tags describing the workflow.","sources":["bblocks://ogc.researchobject.ro-crate.bioschemas.computational-workflow"],"effectiveId":"http://schema.org/keywords"},{"path":["license"],"id":"http://schema.org/license","description":"A license document that applies to the workflow, typically indicated by URL.","required":true,"sources":["bblocks://ogc.researchobject.ro-crate.bioschemas.computational-workflow"],"effectiveId":"http://schema.org/license"},{"path":["producer"],"id":"http://schema.org/producer","description":"The person or organization who produced the workflow.","sources":["bblocks://ogc.researchobject.ro-crate.bioschemas.computational-workflow"],"effectiveId":"http://schema.org/producer"},{"path":["publisher"],"id":"http://schema.org/publisher","description":"The publisher of the workflow.","sources":["bblocks://ogc.researchobject.ro-crate.bioschemas.computational-workflow"],"effectiveId":"http://schema.org/publisher"},{"path":["sdPublisher"],"id":"http://schema.org/sdPublisher","description":"The party responsible for generating and publishing the current structured data markup for the workflow.","required":true,"sources":["bblocks://ogc.researchobject.ro-crate.bioschemas.computational-workflow"],"effectiveId":"http://schema.org/sdPublisher"},{"path":["version"],"id":"http://schema.org/version","description":"The version of the workflow.","required":true,"sources":["bblocks://ogc.researchobject.ro-crate.bioschemas.computational-workflow"],"effectiveId":"http://schema.org/version"},{"path":["input","encodingFormat"],"id":"http://schema.org/encodingFormat","description":"URL(s) of the accepted format(s). Strongly recommended: if absent, nothing should be assumed about the FormalParameter's encoding formats. Recommended vocabulary: the [EDAM](http://edamontology.org/) `format` branch, rooted at [`format_1915`](http://edamontology.org/format_1915).","effectiveId":"http://schema.org/encodingFormat"},{"path":["input","valueRequired"],"id":"http://schema.org/valueRequired","description":"Whether the FormalParameter must be specified. Commonly only used for inputs.","schema_type":"boolean","effectiveId":"http://schema.org/valueRequired"},{"path":["input","defaultValue"],"id":"http://schema.org/defaultValue","description":"The default value for the FormalParameter. Commonly only used for inputs.","effectiveId":"http://schema.org/defaultValue"},{"path":["input","defaultValue","name"],"id":"http://schema.org/name","required":true,"schema_type":"string","effectiveId":"http://schema.org/name"},{"path":["input","defaultValue","identifier"],"id":"http://schema.org/identifier","schema_type":"string","effectiveId":"http://schema.org/identifier"},{"path":["input","defaultValue","url"],"id":"http://schema.org/url","schema_type":"string","format":"uri","effectiveId":"http://schema.org/url"},{"path":["input","defaultValue","additionalType"],"id":"http://schema.org/additionalType","schema_type":"string","format":"uri","effectiveId":"http://schema.org/additionalType"},{"path":["input","additionalType"],"id":"http://schema.org/additionalType","description":"A more specific type for the item, typically from an external vocabulary \u2014 commonly a term from the [EDAM](http://edamontology.org/) `data` branch for a FormalParameter's data type.","effectiveId":"http://schema.org/additionalType"},{"path":["input","description"],"id":"http://schema.org/description","description":"A description of the item.","schema_type":"string","effectiveId":"http://schema.org/description"},{"path":["input","identifier"],"id":"http://schema.org/identifier","description":"Any kind of identifier for this item (e.g. an ISBN, GTIN, or UUID), given as a bare string, a URI, or a full `PropertyValue`.","effectiveId":"http://schema.org/identifier"},{"path":["input","identifier","name"],"id":"http://schema.org/name","schema_type":"string","effectiveId":"http://schema.org/name"},{"path":["input","identifier","identifier"],"id":"http://schema.org/identifier","schema_type":"string","effectiveId":"http://schema.org/identifier"},{"path":["input","identifier","url"],"id":"http://schema.org/url","schema_type":"string","format":"uri","effectiveId":"http://schema.org/url"},{"path":["input","identifier","additionalType"],"id":"http://schema.org/additionalType","schema_type":"string","format":"uri","effectiveId":"http://schema.org/additionalType"},{"path":["input","identifier","propertyID"],"id":"http://schema.org/propertyID","schema_type":"string","effectiveId":"http://schema.org/propertyID"},{"path"