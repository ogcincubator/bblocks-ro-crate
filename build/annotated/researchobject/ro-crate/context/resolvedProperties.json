{"defs":{},"properties":[{"path":["input"],"id":"https://bioschemas.org/terms/input","description":"An input required to use the computational workflow (e.g. an Excel spreadsheet, a BAM file).","required":true,"effectiveId":"https://bioschemas.org/terms/input"},{"path":["output"],"id":"https://bioschemas.org/terms/output","description":"An output produced by the workflow.","required":true,"effectiveId":"https://bioschemas.org/terms/output"},{"path":["creativeWorkStatus"],"id":"http://schema.org/creativeWorkStatus","description":"The status of the workflow in terms of its stage in a lifecycle, e.g. Incomplete, Draft, Published, Obsolete.","effectiveId":"http://schema.org/creativeWorkStatus"},{"path":["documentation"],"id":"http://schema.org/documentation","description":"Documentation describing the ComputationalWorkflow and its use.","effectiveId":"http://schema.org/documentation"},{"path":["funding"],"id":"http://schema.org/funding","description":"The funding for the workflow.","effectiveId":"http://schema.org/funding"},{"path":["maintainer"],"id":"http://schema.org/maintainer","description":"The Person or Organization that manages contributions to, and/or publication of, the workflow.","effectiveId":"http://schema.org/maintainer"},{"path":["softwareRequirements"],"id":"http://schema.org/softwareRequirements","description":"Component dependency requirements for the workflow (runtime environments, shared libraries not bundled with it).","effectiveId":"http://schema.org/softwareRequirements"},{"path":["conditionsOfAccess"],"id":"http://schema.org/conditionsOfAccess","description":"Conditions that affect the availability of, or method(s) of access to, the workflow.","schema_type":"string","effectiveId":"http://schema.org/conditionsOfAccess"},{"path":["targetProduct"],"id":"http://schema.org/targetProduct","description":"Target operating system(s) / product(s) to which the workflow applies.","effectiveId":"http://schema.org/targetProduct"},{"path":["programmingLanguage"