<bblocks://ogc.researchobject.ro-crate.context> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Model ;
    rdfs:label "RO-Crate JSON-LD Context" ;
    dct:abstract "Assembles the RO-Crate 1.3 JSON-LD context from its constituent vocabulary building blocks, and adds the RO-Crate-specific term overrides (`File`, `Journal`, `HTML`) and namespace prefix declarations. The context produced by this block is equivalent, term for term, to <https://w3id.org/ro/crate/1.3/context>."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2026-08-12T00:00:00+00:00"^^xsd:dateTime ;
    dct:description [ dct:format "application/json" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-ro-crate/build/generateddocs/json-full/researchobject/ro-crate/context/index.json> ],
        [ dct:format "text/html" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-ro-crate/bblock/ogc.researchobject.ro-crate.context> ],
        [ dct:format "text/markdown" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-ro-crate/build/generateddocs/markdown/researchobject/ro-crate/context/index.md> ] ;
    dct:hasVersion "1.0.0" ;
    dct:modified "2026-08-12"^^xsd:date ;
    dct:source <https://w3id.org/ro/crate/1.3/context>,
        <https://www.researchobject.org/ro-crate/specification/1.3/>,
        <https://www.researchobject.org/ro-crate/specification/1.3/metadata.html> ;
    skos:inScheme <https://ogcincubator.github.io/bblocks-ro-crate/> ;
    skos:prefLabel "RO-Crate JSON-LD Context" ;
    skos:topConceptOf <https://ogcincubator.github.io/bblocks-ro-crate/> ;
    dcat:keyword "context",
        "jsonld",
        "ro-crate" ;
    prof:hasResource [ dct:conformsTo <https://json-schema.org/draft/2020-12/schema> ;
            dct:format "application/json" ;
            prof:hasArtifact <https://ogcincubator.github.io/bblocks-ro-crate/build/annotated/researchobject/ro-crate/context/schema.json> ;
            prof:hasRole role:schema ],
        [ dct:conformsTo <https://json-schema.org/draft/2020-12/schema> ;
            dct:format "application/yaml" ;
            prof:hasArtifact <https://ogcincubator.github.io/bblocks-ro-crate/build/annotated/researchobject/ro-crate/context/schema.yaml> ;
            prof:hasRole role:schema ],
        [ dct:conformsTo <https://www.w3.org/TR/json-ld11/> ;
            dct:format "application/ld+json" ;
            prof:hasArtifact <https://ogcincubator.github.io/bblocks-ro-crate/build/annotated/researchobject/ro-crate/context/context.jsonld> ;
            prof:hasRole role:mapping ] ;
    bblocks:dependsOn <bblocks://ogc.model.cross-domain.codemeta>,
        <bblocks://ogc.model.cross-domain.dcterms>,
        <bblocks://ogc.model.cross-domain.geosparql>,
        <bblocks://ogc.model.cross-domain.iana-relations>,
        <bblocks://ogc.model.cross-domain.pav>,
        <bblocks://ogc.model.cross-domain.pcdm>,
        <bblocks://ogc.model.cross-domain.prof>,
        <bblocks://ogc.model.cross-domain.schema-org>,
        <bblocks://ogc.ogc-utils.prov>,
        <bblocks://ogc.researchobject.ro-crate.vocab.bioschemas>,
        <bblocks://ogc.researchobject.ro-crate.vocab.ro-terms> ;
    bblocks:hasSourceJsonLdContext <https://ogcincubator.github.io/bblocks-ro-crate/_sources/context/context.jsonld> ;
    bblocks:status <http://www.opengis.net/def/status/under-development> ;
    bblocks:validationPassed true .

