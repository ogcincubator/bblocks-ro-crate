<https://w3id.org/ro/crate/1.3/context> rdfs:label "RO-Crate 1.3 JSON-LD Context" .

<https://ogcincubator.github.io/bblocks-ro-crate/> a skos:ConceptScheme,
        dcat:Catalog,
        bblocks:BBlocksRegister ;
    rdfs:label "Building Blocks - RO-Crate Building Blocks" ;
    dct:abstract """Building blocks reconstructing the [RO-Crate 1.3](https://www.researchobject.org/ro-crate/specification/1.3/)
JSON-LD context from independently reusable vocabulary fragments.
"""^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:description """This register splits the [RO-Crate 1.3 JSON-LD context](https://w3id.org/ro/crate/1.3/context) into
one building block per source vocabulary (Schema.org, PCDM, PROF, Dublin Core Terms, IANA link
relations, Bioschemas, GeoSPARQL, CodeMeta, PROV/PAV, ro-terms), plus a block that assembles them
back together with RO-Crate's own term overrides and namespace prefixes. The assembled context is
equivalent, term for term, to the original. See the
[`ro-crate.context`](bblocks://ogc.researchobject.ro-crate.context) block for the full composition and
provenance notes.
"""^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:modified "2026-08-12T08:53:39.039296"^^xsd:dateTime ;
    owl:imports <https://opengeospatial.github.io/bblocks/register.json> ;
    skos:hasTopConcept <bblocks://ogc.researchobject.ro-crate.context>,
        <bblocks://ogc.researchobject.ro-crate.vocab.bioschemas>,
        <bblocks://ogc.researchobject.ro-crate.vocab.codemeta>,
        <bblocks://ogc.researchobject.ro-crate.vocab.dcterms>,
        <bblocks://ogc.researchobject.ro-crate.vocab.geosparql>,
        <bblocks://ogc.researchobject.ro-crate.vocab.iana-relations>,
        <bblocks://ogc.researchobject.ro-crate.vocab.pcdm>,
        <bblocks://ogc.researchobject.ro-crate.vocab.prof>,
        <bblocks://ogc.researchobject.ro-crate.vocab.prov-pav>,
        <bblocks://ogc.researchobject.ro-crate.vocab.ro-terms>,
        <bblocks://ogc.researchobject.ro-crate.vocab.schema-org> ;
    skos:prefLabel "Building Blocks - RO-Crate Building Blocks" ;
    prof:hasResource [ rdfs:label "This Building Blocks Register in RDF Turtle format" ;
            dct:type "text/turtle" ;
            ns1:relation <http://www.iana.org/assignments/relation/self> ;
            ns2:hasTarget <https://ogcincubator.github.io/bblocks-ro-crate/build/bblocks.ttl> ],
        [ rdfs:label "This Building Blocks Register in JSON-LD format" ;
            dct:type "application/ld+json" ;
            ns1:relation <http://www.iana.org/assignments/relation/self> ;
            ns2:hasTarget <https://ogcincubator.github.io/bblocks-ro-crate/build/bblocks.jsonld> ],
        [ rdfs:label "This Building Blocks Register in JSON format" ;
            dct:type "application/json" ;
            ns1:relation <http://www.iana.org/assignments/relation/self> ;
            ns2:hasTarget <https://ogcincubator.github.io/bblocks-ro-crate/build/register.json> ] ;
    foaf:homepage <https://ogcincubator.github.io/bblocks-ro-crate/> ;
    bblocks:hasValidationReport <https://ogcincubator.github.io/bblocks-ro-crate/build/tests/report.html> .

